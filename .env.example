# Database (PostgreSQL — use Neon or local pg)
DATABASE_URL=postgresql://user:password@localhost:5432/formforge

# NextAuth v5
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=FormForge <noreply@formforge.dev>

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
SERVER_PORT=3001
