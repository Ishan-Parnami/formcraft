# Database (PostgreSQL — use Neon or local pg)
DATABASE_URL=postgresql://user:password@localhost:5432/formcraft

# NextAuth v5
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — skip if not available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Resend (leave unset in dev: emails are logged to console instead)
RESEND_API_KEY=
EMAIL_FROM=FormCraft <noreply@formcraft.dev>

# Upstash Redis (optional — falls back to in-memory rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
SERVER_PORT=3001
